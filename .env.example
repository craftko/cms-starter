# Local Docker defaults. Replace every secret in production.
DATABASE_URL=postgresql://cms:cms-local-password@postgres:5432/cms
POSTGRES_DB=cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=cms-local-password

# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# Public URL of this CMS, including https:// in production.
SERVER_URL=http://localhost:3000

# Comma-separated frontend origins allowed to call the REST API.
# Keep this explicit; never use * in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Convenience for the local Docker quick start only. Set false in production and use migrations.
PAYLOAD_DB_PUSH=true
